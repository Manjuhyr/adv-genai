# secrets — never committed
.env
# each student's own work repository (its own Git history, pushed to their own GitHub)
# environment and caches (uv sync recreates them)
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
# editor / OS
.vscode/
.DS_Store
# Office lock files created while a deck or document is open
~$*
# instructor-only material (decks, instructor packs) — kept on the instructor's machine, never pushed
instructor/
sessions/
*.pptx
*Instructor_Pack*
# tokenizer files downloaded by tiktoken (re-downloaded on demand)
.tiktoken_cache/
